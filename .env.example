# Environment Configuration Template for Access Control Audit Platform (CS-15)
# COPY THIS FILE TO .env BEFORE DEPLOYMENT (DO NOT COMMIT REAL SECRETS TO GIT)

FLASK_ENV=production
FLASK_APP=run.py

# Security & Signing Keys (Use 32+ random characters in production)
SECRET_KEY=your_production_secret_key_here

# Administrator Pre-Seeding Credentials
ADMIN_USERNAME=khadija_auditor
ADMIN_EMAIL=auditor@example.local
ADMIN_PASSWORD=your_strong_admin_password_here

# Database Configuration (SQLite local, PostgreSQL production)
# Local SQLite default (leave empty to use default instance/khadija_access_audit.db)
# DATABASE_URL=sqlite:///instance/khadija_access_audit.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Demo Seeding Control (Set False in production to disable sample auditees and lab files)
SEED_DEMO_DATA=False
SESSION_COOKIE_SECURE=True
